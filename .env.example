# Copie este arquivo para ".env" e ajuste os valores (o ".env" é ignorado pelo Git).
MONGODB_URI=mongodb://127.0.0.1:27017/gestao-de-alunos-test
PORT=3000

# Credenciais do administrador pré-cadastrado pelo seed (usadas nos testes)
ADMIN_EMAIL=admin@escola.com
ADMIN_SENHA=admin123

# Disciplina em que o aluno criado nos testes será matriculado (id do seed)
DISCIPLINA_ID=disciplina-matematica
